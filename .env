# ==============================================================================
# AI Chatbot Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="AI Chatbot Service"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","*"]
API_KEY=""

# LLM Provider Configuration ("openai", "gemini", or "local")
DEFAULT_LLM_PROVIDER="gemini"

# OpenAI Settings
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1024

# Google Gemini Settings
GEMINI_API_KEY="AQ.Ab8RN6JLRKqfZuPizUe6A2rB8FLIeajz2BjbLFuB2nzsTuLZjg"
GEMINI_MODEL="models/gemini-2.5-flash"

# Local / Self-hosted LLM (Ollama or vLLM compatible)
LOCAL_LLM_URL="http://localhost:11434/v1"
LOCAL_LLM_MODEL="llama3"

# Embeddings Configuration ("openai", "gemini", or "local")
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Vector Store (Qdrant)
QDRANT_HOST="http://localhost:6333"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY="r9rEp9uTNm2KIdrc3nUhJiuh7i8CQ54q"
QDRANT_COLLECTION="knowledge_base"
QDRANT_PREFER_GRPC=false

# Memory & Cache (Redis)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
MEMORY_TTL_SECONDS=86400
MEMORY_WINDOW_SIZE=10

# RAG Retrieval Settings
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.0
